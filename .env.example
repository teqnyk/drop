# Drop — environment
#
# Copy to `.env.local` and fill in. Every value below is a real credential name
# the application reads; none of them have defaults, because a demo that
# silently runs on a fallback is a demo that lies about what it needs.
#
# Drop is a PUBLIC repository. Never commit a filled-in copy of this file.

# ── Local ────────────────────────────────────────────────────────────────────
# Beaam's dev formation assigns ports from ~/Dev/.env; 3020 keeps Drop clear of
# beaam-app (3010) and the marketing sites (4321-4324).
PORT_DROP=3020
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# ── MongoDB — the primary database (PRD §14) ─────────────────────────────────
# Releases, reservations, orders, entitlements and storefront_events.
#
# For local development, `pnpm db:start` runs MongoDB on 27077 and this is the
# URI to use. Swap in an Atlas connection string for anything shared — nothing
# else in the application changes.
MONGODB_URI=mongodb://127.0.0.1:27077
MONGODB_DB=drop

# ── Supabase — authentication only ───────────────────────────────────────────
# Identity for the creator dashboard. Application data lives in MongoDB, so
# Supabase holds nothing but the account. No service-role key: there is no
# Supabase data to reach past RLS for, and a key that can is a key that leaks.
#
# Create ONE user by hand in the Supabase dashboard (Authentication → Users)
# and list its address below. There is no sign-up page on purpose.
# All three must be set, or the dashboard refuses in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated allowlist. Empty means nobody gets in — a valid Supabase
# session is not the same thing as being this store's creator.
DROP_CREATOR_EMAILS=

# ── Stripe — payments, TEST MODE ─────────────────────────────────────────────
# Drop must never be pointed at a live-mode key. Demo purchases are not real.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Resend — confirmation and delivery email ─────────────────────────────────
# Domain verification is DNS and has lead time; start it early.
RESEND_API_KEY=
RESEND_FROM=

# ── Cloudflare R2 — the product file ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Sentry — error tracking ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── OpenTelemetry → Beaam ────────────────────────────────────────────────────
# The whole point. Ingest key comes from the Drop production stack in Beaam.
OTEL_EXPORTER_OTLP_ENDPOINT=https://app.beaam.app/api/otlp
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=drop-storefront

# ── Demo control centre (PRD §10) ────────────────────────────────────────────
# Guards /demo. Unset in an unrelated deployment ⇒ the control centre is off.
# A memorable one is fine locally; generate a real one for anything deployed.
DROP_DEMO_SECRET=local-demo-secret
