{
  "name": "drop",
  "version": "0.1.0",
  "private": true,
  "description": "Drop — a demonstration storefront for limited digital releases. The sample application behind Beaam's documentation.",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --port ${PORT_DROP:-3020}",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "db:start": "mkdir -p .localdb && mongod --dbpath .localdb --port 27077 --bind_ip 127.0.0.1",
    "db:reset": "tsx scripts/seed.ts",
    "pretest": "tsc --noEmit",
    "check": "tsc --noEmit && eslint . && vitest run",
    "asset:build": "tsx scripts/build-asset.ts",
    "asset:seed": "pnpm asset:build && tsx scripts/upload-assets.ts",
    "asset:push": "pnpm asset:build && tsx scripts/upload-assets.ts",
    "check:deploy": "pnpm check && next build",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "mongodb": "^6.12.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.11",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.94.0"
  },
  "license": "MIT",
  "author": "Teqnyk Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/teqnyk/drop.git"
  }
}
