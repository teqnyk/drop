{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop",
  // Points at the wrapper, not the generated worker: OpenNext only exports a
  // fetch handler, and Cron Triggers invoke scheduled(). See custom-worker.ts.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-21",
  // nodejs_compat is required by OpenNext, and by the MongoDB driver.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  "triggers": {
    // Work the delivery queue, every minute.
    //
    // Frequency does not affect how fast attempts are spent — runFulfilment
    // only claims jobs whose `next_attempt_at` has passed, so the backoff
    // schedule [0, 30s, 2m, 10m] gates that on its own. What it affects is
    // LATENCY: on a five-minute cron, a retry due in 30 seconds waits up to
    // five minutes, and the first backoff step stops meaning anything.
    //
    // Cheap when idle: one indexed query that matches nothing.
    "crons": ["* * * * *"]
  },

  // The scheduled handler calls the app's own route through this binding, so
  // each cron step gets its own Worker invocation and CPU budget.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "drop"
    }
  ],

  // The product file customers download. A binding rather than the S3 API:
  // `next dev` gets the same shape through initOpenNextCloudflareForDev, so
  // local development and the deploy exercise one code path.
  //
  // Buyers must never be able to enumerate this bucket — the entitlement token
  // is the only way in, which is why nothing here is a public bucket or a
  // signed URL with a guessable key.
  //
  // No preview_bucket_name on purpose. It makes local and preview runs read a
  // SEPARATE bucket from the one every tool names, so `pnpm asset:seed` filled
  // "drop-product-files" while `next dev` read an empty
  // "drop-product-files-preview" and the dashboard reported, confidently, that
  // no product file existed. One bucket, one name, in every mode.
  "r2_buckets": [
    {
      "binding": "PRODUCT_FILES",
      "bucket_name": "drop-product-files"
    }
  ]
  // NEVER enable Smart Placement. Beaam's own runbooks record that it kills
  // scheduled workers; Drop has no cron yet, but the habit is worth keeping.
}
